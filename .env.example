# DeepSeek (OpenAI-compatible) — the agent's planner model.
# Reuse the same key as the rag-service project, or create one at
# https://platform.deepseek.com . Copy this file to .env and fill it in.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Tavily — backs the web_search tool. Create a key at https://tavily.com .
TAVILY_API_KEY=your_tavily_api_key_here

# Gemini — embeds the doc_lookup query against P2's existing Chroma store.
# Reuse the same key as the rag-service project.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-v4-flash
# WEB_SEARCH_MAX_RESULTS=3
# EMBEDDING_MODEL=models/gemini-embedding-001
# DOC_CHROMA_PATH=../rag-service/chroma_store
# DOC_COLLECTION=doc_eval_corpus
# DOC_TOP_K=4
# SANDBOX_ENABLED=true   # set false on managed hosting (no Docker daemon) for a clean code_exec message
